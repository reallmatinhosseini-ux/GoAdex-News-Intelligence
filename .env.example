# All keys are optional. Without a key the matching connector reports "not configured"
# on the Providers page — the app never substitutes invented data.

# FRED / ALFRED (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
# Unlocks: BLS/Census release dates (CPI, NFP, PPI, Retail Sales, JOLTS, claims...),
# real-time vintages (first-release values, look-ahead-safe history), dollar index, VIX.
FRED_API_KEY=

# BLS API v2 key (optional, raises limits from 25 to 500 queries/day)
BLS_API_KEY=

# Market prices (Twelve Data — free tier is delayed/rate-limited; check your plan)
# Unlocks: XAUUSD/EURUSD prices, technical levels, event studies, post-release evaluation.
TWELVEDATA_API_KEY=

# Trading Economics (paid) — consensus forecasts, global calendar incl. ECB, ISM, Conf. Board
TRADINGECONOMICS_API_KEY=

# Anthropic — narrative synthesis, web research with citations, AI analyst
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Set to 0 to disable LLM web research (it costs tokens on every research stage)
LLM_WEB_RESEARCH=1

DEFAULT_TIMEZONE=Asia/Dubai
DB_PATH=data/intel.db
PORT=8600

# Email alerts for new waitlist sign-ups and investor interest (sent from your own mailbox via SMTP).
# Gmail: turn on 2-Step Verification, create an app password at https://myaccount.google.com/apppasswords
NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
